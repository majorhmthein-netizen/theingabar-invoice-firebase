rules_version = '2';
// Theingabar Invoice — Firestore rules (v2, Firebase Auth enforced).
//
// HOW TO DEPLOY (no PC needed, but the console step cannot be done from
// code): Firebase console -> Firestore Database -> Rules -> paste this
// whole file -> Publish. Also enable in Authentication -> Sign-in method:
// Email/Password, Google, and Phone. Authorise the app domain
// theingabar-invoice-firebase.onrender.com (Authentication -> Settings ->
// Authorized domains).
//
// SECURITY MODEL
// * Every read/write requires request.auth != null. Unauthenticated
//   reads are DENIED (v1 had reads open — that is closed here).
// * Admin is decided ONLY by a REAL, VERIFIED Google sign-in: the
//   Firebase ID token must have email_verified == true, email in the
//   admin list below, and sign_in_provider == 'google.com'. A typed
//   email string, a localStorage value, or a client-side flag can NEVER
//   satisfy this rule. isAdmin in a user doc is a display marker only
//   and is NEVER trusted for access.
// * Mechanics sign in with Firebase Phone Auth (SMS OTP). Their user
//   doc id is their Firebase Auth uid; the doc's `localId` is the
//   app-local user id (e.g. "han", "aung") used as invoice.userId.
// * Invoices: any authenticated user may READ (the Home viewer lists
//   all users' logs read-only by design). WRITES need the caller to be
//   the owner (their user doc localId == invoice.userId) AND their user
//   doc status == "approved" — pending users cannot write. Admin
//   (verified Google token) can read/write all invoices.
// * users/{uid}: a user may read any authenticated user's doc (viewer
//   needs usernames) but may only WRITE their own doc, and only their
//   own KBZ template / profile fields. They can NEVER set isAdmin,
//   phoneVerified, or status on their own doc (create or update).
//   Admin can write any user doc (approve / reject / suspend /
//   manually verify a phone).
// * meta/shop (full template metadata): read for authenticated users,
//   write ONLY for Admin (verified Google token).
// * Validation (kept from v1): 1-20 items, every item (desc: string,
//   amount: int >= 0), total an int >= 0 and EXACTLY equal to the sum
//   of the item amounts (explicit disjunction — rules have no loops).
//   Invoice `no` must match YYYYMMDD-NNN when present; createdAt may
//   be a number (client ms) or a timestamp.
// * Max 5 users is enforced in the app UI, not in rules (rules cannot
//   count documents). The Admin panel refuses a 6th user.
//
// BOOTSTRAP (seed Admin): Han Min Thein signs in with Google
// (hanmintheinn@gmail.com or majorhmthein@gmail.com) via the hidden
// long-press login. The verified token satisfies isVerifiedGoogleAdmin(),
// so the Admin branch of the users create rule allows creating the seed
// Admin doc with isAdmin: true. A non-admin can never create a doc
// with isAdmin: true, and can never change their own isAdmin to true.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isVerifiedGoogleAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['hanmintheinn@gmail.com', 'majorhmthein@gmail.com']
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAuthed() {
      return request.auth != null;
    }
    // The caller's own user doc (doc id == Firebase Auth uid). Returns
    // null when the caller has no user doc yet (then owner checks fail).
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function callerHasDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function callerLocalId() {
      return callerDoc().localId;
    }
    function callerIsApproved() {
      return callerHasDoc() && callerDoc().status == 'approved';
    }
    function isInvoiceOwner(data) {
      return callerHasDoc()
        && data.userId is string
        && callerLocalId() == data.userId;
    }

    // ---- invoice validation (v1, plus no / createdAt) ----
    function isValidItem(item) {
      return item is map
        && item.desc is string && item.desc.size() > 0
        && item.amount is int && item.amount >= 0;
    }
    function allItemsValid(items) {
      return (items.size() <= 0 || isValidItem(items[0])) &&
    (items.size() <= 1 || isValidItem(items[1])) &&
    (items.size() <= 2 || isValidItem(items[2])) &&
    (items.size() <= 3 || isValidItem(items[3])) &&
    (items.size() <= 4 || isValidItem(items[4])) &&
    (items.size() <= 5 || isValidItem(items[5])) &&
    (items.size() <= 6 || isValidItem(items[6])) &&
    (items.size() <= 7 || isValidItem(items[7])) &&
    (items.size() <= 8 || isValidItem(items[8])) &&
    (items.size() <= 9 || isValidItem(items[9])) &&
    (items.size() <= 10 || isValidItem(items[10])) &&
    (items.size() <= 11 || isValidItem(items[11])) &&
    (items.size() <= 12 || isValidItem(items[12])) &&
    (items.size() <= 13 || isValidItem(items[13])) &&
    (items.size() <= 14 || isValidItem(items[14])) &&
    (items.size() <= 15 || isValidItem(items[15])) &&
    (items.size() <= 16 || isValidItem(items[16])) &&
    (items.size() <= 17 || isValidItem(items[17])) &&
    (items.size() <= 18 || isValidItem(items[18])) &&
    (items.size() <= 19 || isValidItem(items[19]));
    }
    function totalMatches(items, total) {
      return (items.size() == 1 && total == items[0].amount) ||
    (items.size() == 2 && total == items[0].amount + items[1].amount) ||
    (items.size() == 3 && total == items[0].amount + items[1].amount + items[2].amount) ||
    (items.size() == 4 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount) ||
    (items.size() == 5 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount) ||
    (items.size() == 6 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount) ||
    (items.size() == 7 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount) ||
    (items.size() == 8 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount) ||
    (items.size() == 9 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount) ||
    (items.size() == 10 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount) ||
    (items.size() == 11 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount) ||
    (items.size() == 12 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount) ||
    (items.size() == 13 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount) ||
    (items.size() == 14 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount) ||
    (items.size() == 15 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount + items[14].amount) ||
    (items.size() == 16 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount + items[14].amount + items[15].amount) ||
    (items.size() == 17 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount + items[14].amount + items[15].amount + items[16].amount) ||
    (items.size() == 18 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount + items[14].amount + items[15].amount + items[16].amount + items[17].amount) ||
    (items.size() == 19 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount + items[14].amount + items[15].amount + items[16].amount + items[17].amount + items[18].amount) ||
    (items.size() == 20 && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount + items[6].amount + items[7].amount + items[8].amount + items[9].amount + items[10].amount + items[11].amount + items[12].amount + items[13].amount + items[14].amount + items[15].amount + items[16].amount + items[17].amount + items[18].amount + items[19].amount);
    }
    function isValidInvoice(data) {
      return data.date is string && data.date.size() > 0
        && data.customer is string && data.customer.size() > 0
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.total is int && data.total >= 0
        && allItemsValid(data.items)
        && totalMatches(data.items, data.total)
        && data.uid is string
        && (!('no' in data) || data.no == null || (data.no is string && data.no.matches('^\\d{8}-\\d{3}$')))
        && (!('userId' in data) || data.userId == null || data.userId is string)
        && (!('createdAt' in data) || data.createdAt is int || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // ---- invoices ----
    // Read: any authenticated user (Home viewer lists all logs read-only).
    // Write: owner + approved, or Admin (verified Google token). A
    // pending user (status != "approved") cannot write at all.
    match /invoices/{docId} {
      allow get, list: if isAuthed();
      allow create, update: if isValidInvoice(request.resource.data)
        && (isVerifiedGoogleAdmin()
          || (isInvoiceOwner(request.resource.data) && callerIsApproved()));
      allow delete: if isVerifiedGoogleAdmin()
        || (isInvoiceOwner(resource.data) && callerIsApproved());
    }

    // ---- users ----
    // Read: any authenticated user (viewer needs usernames). Write: only
    // the owner, and only their own template/profile fields — isAdmin,
    // phoneVerified and status can never be set by a non-admin, on
    // create or on update. Admin (verified Google token) can write any
    // user doc, including approval and manual phone verification.
    match /users/{uid} {
      allow get, list: if isAuthed();
      allow create: if isVerifiedGoogleAdmin()
        || (request.auth.uid == uid
          && request.resource.data.get('isAdmin', false) == false
          && request.resource.data.get('phoneVerified', false) == false
          && request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.localId is string);
      allow update: if isVerifiedGoogleAdmin()
        || (request.auth.uid == uid
          && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
          && request.resource.data.get('phoneVerified', false) == resource.data.get('phoneVerified', false)
          && request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
          && request.resource.data.get('adminVerifiedBy', null) == resource.data.get('adminVerifiedBy', null)
          && request.resource.data.get('adminVerifiedAt', null) == resource.data.get('adminVerifiedAt', null)
          && request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null)
          && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null)
          && request.resource.data.get('localId', null) == resource.data.get('localId', null)
          && request.resource.data.get('authUid', null) == resource.data.get('authUid', null));
      allow delete: if isVerifiedGoogleAdmin();
    }

    // ---- meta (full template metadata) ----
    // Read: any authenticated user. Write: Admin only (verified Google).
    match /meta/{docId} {
      allow get, list: if isAuthed();
      allow create, update, delete: if isVerifiedGoogleAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
